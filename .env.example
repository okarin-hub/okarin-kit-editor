# Optional / Opsional: Supabase cloud save (File > Save project)
# Leave this file as is to use browser storage only. / Biarkan apa adanya untuk memakai penyimpanan browser saja.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional / Opsional: where Help > Check for updates reads the latest release from (GitHub "latest release" JSON)
# NEXT_PUBLIC_UPDATE_FEED_URL=https://api.github.com/repos/okarin-hub/okarin-kit-editor/releases/latest

# Optional / Opsional: use another library folder (logos, patterns, fonts, templates)
# KIT_LIBRARY_DIR=D:/my-kit-library
